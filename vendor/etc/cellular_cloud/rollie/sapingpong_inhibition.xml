<?xml version="1.0" encoding="UTF-8"?>

<AppConfig>
    <ParaList>
        <!-- 灭屏时pingpong次数-->
        <mNumScreenOff>5</mNumScreenOff>
        <!-- 灭屏时pingpong时间 5min 5*60*1000-->
        <mDurationTimeScreenOff>300000</mDurationTimeScreenOff>
        <!-- 亮屏时pingpong次数-->
        <mNumScreenOn>3</mNumScreenOn>
        <!-- 亮屏时pingpong时间 1min 1*60*1000-->
        <mDurationTimeScreenOn>60000</mDurationTimeScreenOn>
        <!-- 睡眠模式时pingpong次数-->
        <mNumSleepModeOn>3</mNumSleepModeOn>
        <!-- 睡眠模式时pingpong时间 10min 10*60*1000-->
        <mDurationTimeSleepModeOn>600000</mDurationTimeSleepModeOn>
     </ParaList>
</AppConfig>

